"""
Filter pods by name, labels, phase, and readiness.
"""
input PodFilter {
  """Case-insensitive substring match on pod name."""
  nameContains: String

  """Kubernetes label selector (e.g. "app=api")."""
  labelSelector: String

  """Exact pod phase (Pending, Running, Succeeded, Failed, Unknown)."""
  phase: String

  """When set, only pods with this overall ready state."""
  ready: Boolean
}

type Pod {
  """Kubeconfig context this resource was loaded from."""
  context: String!
  name: String!
  namespace: String!
  phase: String!
  ready: Boolean!
  restarts: Int!
  lastRestartAt: Time
  """Reason from the most recent container lastState.terminated (OOMKilled, Error, …)."""
  lastRestartReason: String
  """Pod creation time (metadata.creationTimestamp)."""
  createdAt: Time
  nodeName: String
  labels: [Label!]!
  containers: [Container!]!
  """
  Kubernetes events involving this pod (BackOff, Killing, Unhealthy, FailedScheduling, …).
  Separate API call — omit from list queries and live subscriptions.
  Events are ephemeral and may expire from the apiserver.
  """
  events: [Event!]!
  """Full object as YAML."""
  yaml: String!
  """Optional; requires metrics-server. Null when unavailable."""
  cpuUsage: String
  """Sum of container CPU limits from the pod spec. Null when unset."""
  cpuLimit: String
  """Optional; requires metrics-server. Null when unavailable."""
  memoryUsage: String
  """Sum of container memory limits from the pod spec. Null when unset."""
  memoryLimit: String
}

type Container {
  name: String!
  image: String!
  ready: Boolean!
  restartCount: Int!
  """Running, Waiting, Terminated, or Unknown."""
  state: String!
  """Waiting/Terminated reason (CrashLoopBackOff, OOMKilled, Error, …)."""
  reason: String
  message: String
  """Previous container run after a restart. Null when it never restarted."""
  lastTerminated: ContainerTermination
}

"""
Last container termination (containerStatuses.lastState.terminated).
The most reliable restart reason for a container that has restarted.
"""
type ContainerTermination {
  """e.g. OOMKilled, Error, Completed."""
  reason: String
  exitCode: Int!
  signal: Int
  message: String
  startedAt: Time
  finishedAt: Time
}

"""
A Kubernetes Event about a pod (kubelet BackOff, Killing, Unhealthy, FailedScheduling, …).
Events are ephemeral and may expire from the apiserver.
"""
type Event {
  name: String!
  """Normal or Warning (Kubernetes event.type)."""
  eventType: String!
  reason: String!
  message: String!
  count: Int!
  firstSeen: Time
  lastSeen: Time
  """Controller/component that emitted the event, e.g. kubelet."""
  source: String
}

type LogLine {
  timestamp: Time
  line: String!
  container: String
}

extend type Query {
  """List pods. Namespace is optional (all namespaces when omitted)."""
  pods(context: String!, namespace: String, filter: PodFilter): [Pod!]!

  """Get a single pod."""
  pod(context: String!, namespace: String!, name: String!): Pod
}

extend type Subscription {
  """
  Stream container logs for a pod. Prefer this over a one-shot query.
  """
  podLogs(
    context: String!
    namespace: String!
    name: String!
    container: String
    tailLines: Int
  ): LogLine!

  """Push updates when pod status changes."""
  podStatus(context: String!, namespace: String!, name: String!): Pod!
}
